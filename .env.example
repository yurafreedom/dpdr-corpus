# Copy to .env (gitignored). Everything is optional; modules that need a missing key are skipped.

# Contact address for polite pools (OpenAlex mailto, Crossref mailto, NCBI, User-Agent).
# Required by Unpaywall. Left empty on purpose until you choose an address.
CONTACT_EMAIL=

# OpenAlex: keyless use is metered at ~$0.10/day (1,000 credits; a search page costs 10).
# A free key from https://openalex.org/settings/api raises the daily allowance.
OPENALEX_API_KEY=

# https://www.ncbi.nlm.nih.gov/account/settings/ (10 req/s instead of 3)
NCBI_API_KEY=
# https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=
# https://core.ac.uk/services/api
CORE_API_KEY=
# BASE requires IP registration: https://www.base-search.net/about/en/contact.php
BASE_API_KEY=
YOUTUBE_API_KEY=
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# X/Twitter (paid, ~$0.005 per post read). Runs only with BOTH set.
X_BEARER_TOKEN=
X_ENABLE=0

# Reddit Data API (harvest/reddit_api.py): script app, one account, "read" scope only.
# The module stays idle unless all five are set. REDDIT_HASH_SALT is a long random secret
# (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`); authors are stored only as
# HMAC-SHA256(salt, author id). Arctic Shift needs it too. Keep it stable: changing it changes every pseudonym.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_HASH_SALT=

# Arctic Shift: also collect comments (large).
ARCTIC_COMMENTS=0
